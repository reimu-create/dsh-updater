{
  "name": "dsh-updater",
  "version": "1.0.0",
  "description": "DSH 更新器：设置面板一键检查并更新 dsh 运行时（下载、校验、替换、适配启动器、自动重启，更新进程脱离 DSH 进程树）",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime"]
    }
  }
}
